# 开发环境 Dockerfile（支持热重载）
FROM node:20-alpine

WORKDIR /app

# 使用阿里云镜像源
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# 安装系统依赖
RUN apk add --no-cache \
    libc6-compat \
    pandoc \
    python3 \
    redis

# 配置 npm 使用淘宝镜像
RUN npm config set registry https://registry.npmmirror.com

# 升级 npm 到最新版本
RUN npm install -g npm@latest

# 复制 package 文件
COPY package.json package-lock.json ./

# 安装依赖
RUN npm install --legacy-peer-deps

# 复制源代码（在 docker-compose 中会被 volume 覆盖）
COPY . .

# 接受环境变量作为构建参数
ARG NEXT_PUBLIC_DIFY_BASE_URL
ARG NEXT_PUBLIC_DIFY_OUTLINE_KEY
ARG NEXT_PUBLIC_DIFY_CHAPTER_KEY
ARG NEXT_PUBLIC_DIFY_LLM_KEY

# 设置环境变量
ENV NEXT_PUBLIC_DIFY_BASE_URL=$NEXT_PUBLIC_DIFY_BASE_URL
ENV NEXT_PUBLIC_DIFY_OUTLINE_KEY=$NEXT_PUBLIC_DIFY_OUTLINE_KEY
ENV NEXT_PUBLIC_DIFY_CHAPTER_KEY=$NEXT_PUBLIC_DIFY_CHAPTER_KEY
ENV NEXT_PUBLIC_DIFY_LLM_KEY=$NEXT_PUBLIC_DIFY_LLM_KEY

# 暴露端口
EXPOSE 3000

# 开发模式启动命令（在 docker-compose 中会被覆盖）
CMD ["npm", "run", "dev"]
