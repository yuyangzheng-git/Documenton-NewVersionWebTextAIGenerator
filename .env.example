# AI Configuration
# Choose your AI platform: dify | openai | gemini | kimi | qwen
AI_PLATFORM=dify

# Dify Configuration (if using dify)
# Get your API keys from https://cloud.dify.ai
NEXT_PUBLIC_DIFY_BASE_URL=http://10.23.22.37/v1
NEXT_PUBLIC_DIFY_OUTLINE_KEY=app-yIhd9xD2SHZ6e9BNTYSWEfYD
NEXT_PUBLIC_DIFY_CHAPTER_KEY=app-wqO8BTPC99CwAGFDabEze6Uz
NEXT_PUBLIC_DIFY_LLM_KEY=app-ThlXmch2AjSRdv6kuvacb4bM

# OpenAI Configuration (if using openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini Configuration (if using gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Kimi Configuration (if using kimi)
KIMI_API_KEY=your-kimi-api-key-here
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Qwen Configuration (if using qwen)
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen-turbo
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Application Settings
NEXT_TELEMETRY_DISABLED=1

# Python Configuration (for DOCX export)
# Specify the Python executable path (for uv or venv managed environments)
# Example: /root/.venv/bin/python or /path/to/uv/managed/python
# Leave empty to use default 'python3'
PYTHON_PATH=

# Redis Configuration (for caching)
# Default: redis://localhost:6379 for local dev
# Docker: redis://redis:6379 for container deployment
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=1

# Cross-Origin Configuration (for multi-port deployment)
# Enable this if you need to run the app on different ports (e.g., 3000 and 3001)
# and use postMessage for cross-window communication
# Set to 'true' to enable cross-origin mode even on localhost
NEXT_PUBLIC_USE_CROSS_ORIGIN_MODE=false

# Child window origin (for cross-origin mode)
# This is where the word-editor will open in a new window
NEXT_PUBLIC_CHILD_WINDOW_ORIGIN=http://10.23.22.37:3001

# Parent window origin (for cross-origin mode)
# This is where the parent page is hosted
NEXT_PUBLIC_PARENT_ORIGIN=http://10.23.22.37:3000
