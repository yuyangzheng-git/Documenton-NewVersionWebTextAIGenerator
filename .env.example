# ============================================
# AI Platform Configuration
# Choose your AI platform: dify, openai, langchain
# ============================================

# ============================================
# Dify Configuration
# ============================================
# Dify Planner App API Key (for generating document outlines)
NEXT_PUBLIC_DIFY_PLANNER_API_KEY=your_planner_app_key_here

# Dify Chapter Writer App API Key (for generating chapter content)
NEXT_PUBLIC_DIFY_CHAPTER_API_KEY=your_chapter_writer_app_key_here

# Dify API Base URL
NEXT_PUBLIC_DIFY_API_URL=http://10.23.22.37/v1

# Dify AI Chat App API Key (for the floating chat window)
NEXT_PUBLIC_DIFY_CHAT_API_KEY=your_chat_app_key_here

# ============================================
# OpenAI Configuration
# ============================================
# OpenAI API Key
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (gpt-4, gpt-3.5-turbo, etc.)
NEXT_PUBLIC_OPENAI_MODEL=gpt-4

# OpenAI Base URL (for custom endpoints or proxies)
NEXT_PUBLIC_OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# LangChain Configuration
# ============================================
# LangChain API Key (usually OpenAI API key)
NEXT_PUBLIC_LANGCHAIN_API_KEY=your_langchain_api_key_here

# LangChain Model
NEXT_PUBLIC_LANGCHAIN_MODEL=gpt-4
